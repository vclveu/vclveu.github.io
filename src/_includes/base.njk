<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "VCLV" }}{% if title %} — VCLV{% endif %}</title>
  <meta name="description" content="{{ description or 'VCLV is an engineering design studio creating original products and interactive experiences through engineering, industrial design and digital manufacturing.' }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="skip"><a href="#main">Skip to content</a></div>

  <header class="site-header">
    <a class="wordmark" href="/" aria-label="VCLV home">
      <span class="wordmark-layer wordmark-c">VCLV</span>
      <span class="wordmark-layer wordmark-m">VCLV</span>
      <span class="wordmark-layer wordmark-y">VCLV</span>
      <span class="wordmark-base">VCLV</span>
    </a>
    <nav class="site-nav">
      <a href="/" {% if nav == "home" %}aria-current="page"{% endif %}>Studio</a>
      <a href="/projects/" {% if nav == "projects" %}aria-current="page"{% endif %}>Projects</a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-col">
        <p class="footer-label">Contact</p>
        <div class="footer-links">
          <a href="https://www.youtube.com/@vclv_engineer" target="_blank" rel="noopener">YouTube</a>
          <a href="https://www.linkedin.com/in/v%C3%A1clav-musil-b73000321/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <div class="footer-col footer-col-right">
        <p class="footer-note">VCLV — engineering design studio.</p>
      </div>
    </div>
  </footer>
</body>
</html>
